# Copy to .env and fill in. .env is not committed.
#
# Used only by docker-compose.yml. The application never reads this file: its database connection is configured in
# config/autoload/local.php, which must use the same database, user and password as below.

# Build args for the app container, so files it creates belong to you
UID=1000
GID=1000

# MariaDB container, applied only when its data volume is first created
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=analytics
MARIADB_USER=analytics
MARIADB_PASSWORD=change-me-too
