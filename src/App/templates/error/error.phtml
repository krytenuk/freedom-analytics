<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var int|null $status
 * @var string|null $reason
 * @var string|null $message
 * @var Throwable|string|null $error Only in development mode
 */

$this->layout()->setVariables(['title' => 'Error']);
?>
<div class="text-center py-4">
    <h1 class="display-4 fw-bold"><?= $this->escapeHtml((string) ($status ?? 500)) ?></h1>
    <h2 class="fs-5"><?= $this->escapeHtml((string) ($reason ?? 'Something went wrong')) ?></h2>
    <p><?= $this->escapeHtml((string) ($message ?? 'Please try again later.')) ?></p>
    <?php if (isset($error)) : ?>
        <pre class="text-start small mt-4 text-wrap"><?= $this->escapeHtml((string) $error) ?></pre>
    <?php endif ?>
    <a href="/" class="btn btn-primary mt-3">Back to the Dashboard</a>
</div>
