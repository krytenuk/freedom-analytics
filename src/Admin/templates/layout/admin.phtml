                    <i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="<?= $groupId ?>" class="nav-content collapse<?= $open ? ' show' : '' ?>"
                    data-bs-parent="#sidebar-nav">
                    <?php foreach ($groupLinks[$group] ?? [] as $route => $label) : ?>
