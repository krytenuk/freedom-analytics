/**
 * Sidebar links. NiceAdmin draws links with the "collapsed" class as not current.
 */
$navLink = fn (string $route, string $icon, string $label, array $params = [], ?string $key = null): string => sprintf(
    '<a class="nav-link%s" href="%s"%s><i class="bi %s"></i><span>%s</span></a>',
    ($key ?? $route) === $activeNav ? '' : ' collapsed',
    $this->escapeHtmlAttr($this->url($route, $params)),
    ($key ?? $route) === $activeNav ? ' aria-current="page"' : '',
    $this->escapeHtmlAttr($icon),
    $this->escapeHtml($label)
);

// Report groups open in the sidebar when one of their pages is current
$groupLinks = [
    'Visitors' => ['visitors' => 'Overview', 'visits' => 'Latest Visits'],
];
