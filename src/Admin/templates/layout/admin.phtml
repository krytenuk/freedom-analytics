                            <a href="<?= $this->url($route) ?>"<?= $activeNav === $route ? ' class="active"' : '' ?>>
                                <i class="bi bi-circle"></i><span><?= $this->escapeHtml($label) ?></span>
                            </a>
                        </li>
                    <?php endforeach ?>
                    <?php foreach ($reports as $id => $label) : ?>
