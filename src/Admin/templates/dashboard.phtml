        'label'         => $label,
        'icon'          => $icon,
        'value'         => $kpis[$key],
        'previous'      => $previousKpis[$key],
        'format'        => $format,
        'lowerIsBetter' => $lowerIsBetter,
    ]);

$moreLink = fn (string $report, string $text = 'View full report'): string => sprintf(
    '<a class="small" href="%s">%s <i class="bi bi-arrow-right"></i></a>',
    $this->url('report', ['id' => $report]),
    $this->escapeHtml($text)
);
